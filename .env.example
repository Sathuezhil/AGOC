RESEND_API_KEY=
RESEND_FROM=AGOC Website <onboarding@resend.dev>

# Hostinger email (info@agoc.ae) — same as Outlook desktop settings
# Incoming: imap.hostinger.com | Outgoing: smtp.hostinger.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@agoc.ae
SMTP_PASS=
MAIL_FROM=AGOC Website <info@agoc.ae>
MAIL_TO=info@agoc.ae

ADMIN_EMAIL=admin@agocsecurity.ae
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=change-this-to-a-long-random-string
MONGODB_URI=mongodb://127.0.0.1:27017/agoc
MONGODB_DB=agoc
